{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(roblox|synapse|krnl|fluxus|delta|hydrogen|electron|codex|novoline|arceus|wave|sirhurt|script-ware|swift|evon|vega|celery|oxygen|trigon|solara|xeno|valyse|jjsploit|nihil).*"
        }
      ],
      "destination": "/script.lua"
    }
  ],
  "headers": [
    {
      "source": "/script.lua",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
